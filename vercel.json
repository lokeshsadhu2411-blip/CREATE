{
  "version": 2,
  "name": "fitnexa-ai",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "APP_URL": "https://fitnexa-ai.vercel.app",
    "NODE_ENV": "production"
  }
}
